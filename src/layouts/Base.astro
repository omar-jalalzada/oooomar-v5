---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Immersive pages (the Constellation home) render edge-to-edge with no header/footer chrome. */
  immersive?: boolean;
}

const { title, description, immersive = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: '/writing/', label: 'Writing' },
  { href: '/labs/', label: 'Labs' },
  { href: '/about/', label: 'About' },
];

const isCurrent = (href: string) =>
  Astro.url.pathname === href || Astro.url.pathname === href.replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Omar Jalalzada — Writing" href={new URL('/rss.xml', Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={immersive ? 'immersive' : undefined}>
    {
      immersive ? (
        <slot />
      ) : (
        <>
          <header class="container">
            <nav>
              <a href="/" class="wordmark">Omar Jalalzada</a>
              <ul>
                {nav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </header>

          <main class="container">
            <slot />
          </main>

          <footer class="container">
            <p>© {new Date().getFullYear()} Omar Jalalzada · <a href="/rss.xml">RSS</a></p>
          </footer>
        </>
      )
    }
  </body>
</html>

<style>
  header {
    padding-block: var(--space-6);
  }

  nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .wordmark {
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  nav ul {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav ul a {
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  nav ul a:hover {
    color: var(--color-accent);
  }

  nav ul a[aria-current='page'] {
    color: var(--color-ink);
    font-weight: 600;
  }

  main {
    min-height: 60vh;
    padding-block: var(--space-8) var(--space-24);
  }

  footer {
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
  }

  footer a {
    color: var(--color-ink-secondary);
  }
</style>
