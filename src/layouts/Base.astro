---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Immersive pages (the Constellation home) render edge-to-edge with no chrome. */
  immersive?: boolean;
}

const { title, description, immersive = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: '/writing/', label: 'Writing' },
  { href: '/labs/', label: 'Labs' },
  { href: '/about/', label: 'About' },
];

const isActive = (href: string) => Astro.url.pathname.startsWith(href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Omar Jalalzada — Writing" href={new URL('/rss.xml', Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={immersive ? 'immersive' : undefined}>
    {
      immersive ? (
        <slot />
      ) : (
        <>
          <div class="calm-bg" aria-hidden="true" />

          <main class="container">
            <slot />
          </main>

          <nav class="cnst-nav" aria-label="Site navigation">
            <a href="/" class="navdot" aria-label="Home"></a>
            <span class="navlinks">
              {nav.map((item) => (
                <a
                  href={item.href}
                  class={isActive(item.href) ? 'active' : undefined}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))}
            </span>
          </nav>
        </>
      )
    }
  </body>
</html>

<style>
  /* Calm, static echo of the canvas world — same palette, no grain, no animation.
     Sits behind content so detail/list pages feel related to the home canvas. */
  .calm-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(60% 50% at 18% 0%, rgba(255, 214, 170, 0.1), transparent 60%),
      radial-gradient(50% 45% at 88% 8%, rgba(196, 184, 255, 0.1), transparent 62%),
      radial-gradient(70% 60% at 50% 100%, rgba(168, 214, 255, 0.1), transparent 70%),
      var(--color-bg);
  }

  main {
    position: relative;
    min-height: 100vh;
    padding-block: var(--space-12) 120px;
  }

  /* Identical to Constellation's cnst-nav — copy/paste of the same CSS rules */
  .cnst-nav {
    display: flex;
    align-items: center;
    gap: 0;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    border: 1px solid rgba(16, 24, 40, 0.07);
    border-radius: 999px;
    box-shadow: 0 24px 60px -24px rgba(20, 40, 120, 0.4);
    padding: 7px;
    position: fixed;
    bottom: 26px;
    left: 0;
    right: 0;
    width: max-content;
    margin-inline: auto;
    z-index: 80;
    transition: gap 0.4s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .cnst-nav:hover {
    gap: 6px;
  }

  .navdot {
    width: 34px;
    height: 34px;
    border: none;
    border-radius: 50%;
    flex-shrink: 0;
    cursor: pointer;
    background: radial-gradient(circle at 35% 30%, #4d78ff, var(--color-accent));
    box-shadow: 0 2px 8px -2px rgba(20, 40, 120, 0.5);
    display: block;
    text-decoration: none;
  }

  .navlinks {
    display: flex;
    align-items: center;
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-width 0.45s cubic-bezier(0.2, 0.75, 0.2, 1), opacity 0.35s ease;
  }

  .cnst-nav:hover .navlinks {
    max-width: 360px;
    opacity: 1;
    padding-left: 4px;
  }

  .navlinks a {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--color-ink);
    text-decoration: none;
    padding: 6px 14px;
    border-radius: 999px;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .navlinks a:hover {
    background: rgba(20, 40, 120, 0.07);
  }

  .navlinks a.active {
    color: var(--color-accent-ink);
    background: var(--color-accent);
  }
</style>
