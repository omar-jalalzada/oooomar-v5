---
import '../styles/global.css';
import { SOFT_PRESENCE } from '../lib/soft-presence';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: '/writing/', label: 'Writing' },
  { href: '/experiments/', label: 'Experiments' },
  { href: '/about/', label: 'About' },
];

const isActive = (href: string) => Astro.url.pathname.startsWith(href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Omar Jalalzada — Writing" href={new URL('/rss.xml', Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="calm-bg" aria-hidden="true" />

    <main class="container">
      <slot />
    </main>

    {/* Hidden while soft presence is live: every section it links to redirects to `/` then.
        SOFT_PRESENCE is false in dev, so the nav is always there while iterating. */}
    {
      !SOFT_PRESENCE && (
        <nav class="site-nav" aria-label="Site navigation">
          <a href="/" class="navdot" aria-label="Home">
            <svg class="navdot-mark" viewBox="0 0 100 100" aria-hidden="true">
              <mask id="navdot-o">
                <rect x="8" y="8" width="84" height="84" rx="30" fill="#fff" />
                <circle cx="50" cy="50" r="14" fill="#000" />
              </mask>
              <rect x="8" y="8" width="84" height="84" rx="30" fill="var(--color-accent)" mask="url(#navdot-o)" />
            </svg>
          </a>
          <span class="navlinks">
            {nav.map((item) => (
              <a
                href={item.href}
                class={isActive(item.href) ? 'active' : undefined}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </span>
        </nav>
      )
    }
  </body>
</html>

<style>
  /* Plain white, behind content. */
  .calm-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: var(--color-bg);
  }

  main {
    position: relative;
    min-height: 100vh;
    padding-block: var(--space-12) 120px;
  }

  /* Floating pill: the home dot, with the section links sliding out on hover. */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    border: 1px solid rgba(16, 24, 40, 0.07);
    border-radius: 999px;
    box-shadow: 0 24px 60px -24px rgba(20, 40, 120, 0.4);
    padding: 7px;
    position: fixed;
    bottom: 26px;
    left: 0;
    right: 0;
    width: max-content;
    margin-inline: auto;
    z-index: 80;
    transition: gap 0.4s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .site-nav:hover {
    gap: 6px;
  }

  .navdot {
    width: 40px;
    height: 40px;
    border: none;
    background: none;
    padding: 0;
    flex-shrink: 0;
    cursor: pointer;
    display: grid;
    place-items: center;
    text-decoration: none;
  }
  .navdot-mark {
    width: 30px;
    height: 30px;
    display: block;
    transition: transform 0.2s cubic-bezier(0.2, 0.75, 0.2, 1);
  }
  .navdot:hover .navdot-mark { transform: scale(1.08); }
  .navdot:active .navdot-mark { transform: scale(0.94); }

  .navlinks {
    display: flex;
    align-items: center;
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-width 0.45s cubic-bezier(0.2, 0.75, 0.2, 1), opacity 0.35s ease;
  }

  .site-nav:hover .navlinks {
    max-width: 360px;
    opacity: 1;
    padding-left: 4px;
  }

  .navlinks a {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--color-ink);
    text-decoration: none;
    padding: 6px 14px;
    border-radius: 999px;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .navlinks a:hover {
    background: rgba(20, 40, 120, 0.07);
  }

  .navlinks a.active {
    color: var(--color-accent-ink);
    background: var(--color-accent);
  }
</style>
