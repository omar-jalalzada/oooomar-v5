---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getVisible } from '../../lib/content';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const labs = await getVisible('labs');
  return labs.map((lab) => ({ params: { slug: lab.id }, props: { lab } }));
}

const { lab } = Astro.props;
const { Content } = await render(lab);
// dev's Vite server doesn't resolve directory indexes for public/ folders;
// production (Vercel) serves the pretty URL
const prototypeUrl = import.meta.env.DEV
  ? `/prototypes/${lab.data.prototype}/index.html`
  : `/prototypes/${lab.data.prototype}/`;
---

<Base title={`${lab.data.title} — Labs — Omar Jalalzada`} description={lab.data.description}>
  <article class="detail">
    <header>
      <p class="meta">
        <a href="/labs/">Labs</a>
        · <time datetime={lab.data.date.toISOString()}>{formatDate(lab.data.date)}</time>
      </p>
      <h1>{lab.data.title}</h1>
      <p class="description">{lab.data.description}</p>
    </header>

    <div class="frame">
      <iframe src={prototypeUrl} title={lab.data.title} loading="lazy"></iframe>
    </div>
    <p class="actions">
      <a href={prototypeUrl} target="_blank" rel="noopener">Open full screen ↗</a>
    </p>

    <div class="prose">
      <Content />
    </div>

    {
      lab.data.tags.length > 0 && (
        <ul class="tags">
          {lab.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</Base>
