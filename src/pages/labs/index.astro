---
import Base from '../../layouts/Base.astro';
import { LabsGrid } from '../../components/ui/LabsGrid';
import { getVisible, byDateDesc } from '../../lib/content';
import { formatDate } from '../../lib/format';

const labs = (await getVisible('labs')).sort(byDateDesc);

const cards = labs.map((lab) => ({
  href: `/labs/${lab.id}/`,
  title: lab.data.title,
  description: lab.data.description,
  meta: formatDate(lab.data.date),
  draft: lab.data.status === 'draft',
}));
---

<Base
  title="Labs — Omar Jalalzada"
  description="Interactive experiments and prototypes — visually captivating, boundary-pushing, AI-native creative work."
>
  <h1>Labs</h1>
  <p class="intro">Interactive experiments. Each one is a self-contained prototype you can open full screen.</p>
  <LabsGrid client:visible {cards} />
</Base>

<style>
  h1 {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .intro {
    max-width: var(--measure);
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-8);
  }
</style>
