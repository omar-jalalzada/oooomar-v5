---
import Base from '../../layouts/Base.astro';
import ExperimentTile from '../../components/experiments/ExperimentTile.astro';
import { experimentCards } from '../../lib/content';
import { SOFT_PRESENCE } from '../../lib/soft-presence';

if (SOFT_PRESENCE) return Astro.redirect('/');

const cards = await experimentCards();
---

<Base
  title="Experiments — Omar Jalalzada"
  description="Interactive experiments and prototypes — visually captivating, boundary-pushing, AI-native creative work."
>
  <h1>Experiments</h1>
  <p class="intro">Interactive experiments. Each one is a self-contained prototype you can open full screen.</p>
  <ExperimentTile {cards} />
</Base>

<style>
  h1 {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .intro {
    max-width: var(--measure);
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-8);
  }
</style>
