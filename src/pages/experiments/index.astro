---
import Base from '../../layouts/Base.astro';
import { ExperimentsGrid } from '../../components/ui/ExperimentsGrid';
import { getVisible, byDateDesc } from '../../lib/content';
import { formatDate } from '../../lib/format';
import { SOFT_PRESENCE } from '../../lib/soft-presence';

if (SOFT_PRESENCE) return Astro.redirect('/');

const experiments = (await getVisible('experiments')).sort(byDateDesc);

const cards = experiments.map((experiment) => ({
  href: `/experiments/${experiment.id}/`,
  title: experiment.data.title,
  description: experiment.data.description,
  meta: formatDate(experiment.data.date),
  draft: experiment.data.status === 'draft',
}));
---

<Base
  title="Experiments — Omar Jalalzada"
  description="Interactive experiments and prototypes — visually captivating, boundary-pushing, AI-native creative work."
>
  <h1>Experiments</h1>
  <p class="intro">Interactive experiments. Each one is a self-contained prototype you can open full screen.</p>
  <ExperimentsGrid client:visible {cards} />
</Base>

<style>
  h1 {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .intro {
    max-width: var(--measure);
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-8);
  }
</style>
