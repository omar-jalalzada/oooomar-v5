---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getVisible } from '../../lib/content';
import { formatDate } from '../../lib/format';
import { SOFT_PRESENCE } from '../../lib/soft-presence';

export async function getStaticPaths() {
  if (SOFT_PRESENCE) return [];
  const experiments = await getVisible('experiments');
  return experiments.map((experiment) => ({ params: { slug: experiment.id }, props: { experiment } }));
}

const { experiment } = Astro.props;
const { Content } = await render(experiment);
// dev's Vite server doesn't resolve directory indexes for public/ folders;
// production (Vercel) serves the pretty URL
const prototypeUrl = import.meta.env.DEV
  ? `/prototypes/${experiment.data.prototype}/index.html`
  : `/prototypes/${experiment.data.prototype}/`;
---

<Base title={`${experiment.data.title} — Experiments — Omar Jalalzada`} description={experiment.data.description}>
  <article class="detail">
    <header>
      <p class="meta">
        <a href="/experiments/">Experiments</a>
      </p>
      <h1>{experiment.data.title}</h1>
      <p class="description">{experiment.data.description}</p>
    </header>

    <div class="frame">
      <iframe src={prototypeUrl} title={experiment.data.title} loading="lazy"></iframe>
    </div>
    <p class="actions">
      <a href={prototypeUrl} target="_blank" rel="noopener">Open full screen ↗</a>
    </p>

    <dl class="facts">
      <div>
        <dt>Created</dt>
        <dd>
          <time datetime={experiment.data.date.toISOString()}>{formatDate(experiment.data.date)}</time>
        </dd>
      </div>
      <div>
        <dt>Technique</dt>
        <dd>{experiment.data.technique.join(' · ')}</dd>
      </div>
    </dl>

    <section class="learnings">
      <h2>Learnings</h2>
      <div class="prose">
        <Content />
      </div>
    </section>
  </article>
</Base>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-12);
    max-width: var(--measure);
    margin: 0 0 var(--space-12);
    padding-block: var(--space-6);
    border-block: 1px solid var(--color-border);
  }

  .facts div {
    display: grid;
    gap: var(--space-1);
  }

  .facts div:last-child {
    flex: 1;
  }

  .facts dt {
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .facts dd {
    margin: 0;
    color: var(--color-ink-secondary);
  }

  .learnings {
    max-width: var(--measure);
  }

  .learnings h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
    line-height: 1.3;
  }
</style>
