---
import Base from '../layouts/Base.astro';
import RoleCard from '../components/work/RoleCard.astro';
import { render } from 'astro:content';
import { getVisible } from '../lib/content';
import { SOFT_PRESENCE } from '../lib/soft-presence';

if (SOFT_PRESENCE) return Astro.redirect('/');

const workEntries = (await getVisible('work')).sort((a, b) => a.data.order - b.data.order);
const caseStudies = new Map((await getVisible('caseStudies')).map((study) => [study.id, study]));
const work = await Promise.all(
  workEntries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

const pressMentions = [
  {
    publication: 'Fitt Insider',
    title: 'Startup Q&A: Kin CEO Omar Jalalzada',
    href: 'https://insider.fitt.co/startup-qa-kin-ceo-omar-jalalzada/',
  },
  {
    publication: 'The Creative Factor',
    title: 'Designing Kin to Help People Hold Themselves Accountable',
    href: 'https://www.thecreativefactor.co/articles/how-we-built-kin-habits',
  },
  {
    publication: 'Product Hunt',
    title: "Why you're approaching your habits all wrong",
    href:
      'https://www.producthunt.com/stories/why-you-re-approaching-your-habits-all-wrong-a-look-at-justin-kan-s-latest-app',
  },
];
---

<Base
  title="About | Omar Jalalzada"
  description="Design leader and maker. Head of Design at Sublime Security."
>
  <article class="prose about">
    <h1>About</h1>

    <p>
      I'm Omar, a design leader and maker. I lead design at
      <a href="https://sublime.security">Sublime Security</a>, where I've helped take the company
      from 0 to Series D.
    </p>
    <p class="social">
      <a href="https://www.linkedin.com/in/omarjalalzada/" rel="me" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V9h3.56v11.45Z" />
        </svg>
        <span class="sr-only">LinkedIn</span>
      </a>
      <a href="https://x.com/OmarJalalzada" rel="me" aria-label="X">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18.24 2.25h3.31l-7.23 8.26 8.51 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64Z" />
        </svg>
        <span class="sr-only">X</span>
      </a>
    </p>

    <h2>Behind the site</h2>
    <p>
      The <a href="/design-system/">design system</a> documents the visual foundations and
      reusable parts that hold this site together. <a href="/explore/index.html">Explore</a> is the
      public sketchbook behind it—a record of the ideas, dead ends, and iterations along the way.
    </p>

    <h2>Work</h2>
    <ul class="cv">
      {
        work.map(({ entry, Content }) => {
          const study = caseStudies.get(entry.id);
          const href = `/work/${entry.id}/`;
          return (
          <li id={entry.id}>
            <div class="line">
              <span class="company">{entry.data.company}</span>
              {entry.data.period && <span class="period">{entry.data.period}</span>}
            </div>
            <p class="role">{entry.data.role}</p>
            {entry.data.card && study && (
              <>
                {/* The text link below is the accessible one; the card repeats it for pointers. */}
                <a
                  class="cover cover-link"
                  href={href}
                  tabindex="-1"
                  aria-hidden="true"
                  style={`view-transition-name: role-card-${entry.id}`}
                >
                  <RoleCard {...entry.data.card} />
                  <span class="cover-hint">View case study</span>
                </a>
                <a class="case-link" href={href}>
                  Read the {study.data.title} case study <span aria-hidden="true">→</span>
                </a>
              </>
            )}
            {entry.data.card && !study && (
              <div class="cover">
                <RoleCard {...entry.data.card} />
              </div>
            )}
            {entry.body?.trim() && (
              <div class="work-context">
                <Content />
              </div>
            )}
          </li>
          );
        })
      }
    </ul>

    <h2>Press mentions</h2>
    <ul class="press">
      {
        pressMentions.map((mention) => (
          <li>
            <a href={mention.href}>
              <span>
                <strong>{mention.publication}</strong>
                <span class="press-title">{mention.title}</span>
              </span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </article>
</Base>

<style is:global>
  /* Matches the opt-in on the case-study pages, so a role card morphs into its case study. */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }

  ::view-transition-group(*) {
    animation-duration: var(--duration-slow);
    animation-timing-function: var(--ease-in-out);
  }
</style>

<style>
  /* The role covers need the full site width; everything else keeps the reading measure. */
  .about {
    max-width: none;
  }

  .about > :not(.cv),
  .line,
  .role,
  .work-context {
    max-width: var(--measure);
  }

  .cover {
    display: block;
    margin-block: var(--space-6);
  }

  .cover-link {
    position: relative;
    color: inherit;
    text-decoration: none;
  }

  .cover-hint {
    position: absolute;
    top: 50%;
    left: 50%;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink);
    background: var(--color-bg);
    border-radius: 999px;
    box-shadow: var(--shadow-md);
    opacity: 0;
    transform: translate(-50%, calc(-50% + var(--space-2)));
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
    pointer-events: none;
  }

  .cover-link:hover .cover-hint {
    opacity: 1;
    transform: translate(-50%, -50%);
  }

  .case-link {
    display: inline-block;
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
  }

  .case-link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .case-link:focus-visible {
    outline: auto;
    outline-offset: var(--space-1);
  }

  .cover + .case-link {
    margin-top: calc(var(--space-2) * -1);
  }

  h1 {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }

  .cv {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  .cv li {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .cv li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .company {
    font-weight: 600;
  }

  .period {
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    white-space: nowrap;
  }

  .role {
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
  }

  .work-context {
    margin-top: var(--space-6);
  }

  .work-context :global(h2) {
    margin-block: var(--space-8) var(--space-3);
    font-size: var(--text-base);
  }

  .work-context :global(h2:first-child) {
    margin-top: 0;
  }

  .work-context :global(p) {
    color: var(--color-ink-secondary);
  }

  .work-context :global(p:last-child) {
    margin-bottom: 0;
  }

  .press {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: thin solid var(--color-border);
  }

  .press li {
    margin: 0;
    border-top: thin solid var(--color-border);
  }

  .press a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    color: var(--color-ink);
    text-decoration: none;
  }

  .press a:hover strong,
  .press a:hover svg {
    color: var(--color-accent);
  }

  .press strong,
  .press-title {
    display: block;
  }

  .press strong {
    font-size: var(--text-base);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .press-title {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
  }

  .press svg {
    flex: 0 0 auto;
    width: var(--space-6);
    height: var(--space-6);
    color: var(--color-ink-tertiary);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .press a:hover svg {
    transform: translate(var(--space-1), calc(var(--space-1) * -1));
  }

  .press a:focus-visible {
    outline: auto;
    outline-offset: var(--space-1);
  }

  .social {
    display: flex;
    gap: var(--space-2);
  }

  .social a {
    display: grid;
    width: var(--space-12);
    height: var(--space-12);
    place-items: center;
    color: var(--color-ink-secondary);
    background: var(--color-surface);
    border: thin solid var(--color-border);
    border-radius: 50%;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .social a:hover {
    color: var(--color-accent);
    background: var(--color-bg);
    border-color: var(--color-accent);
  }

  .social a:active {
    transform: scale(0.96);
  }

  .social a:focus-visible {
    outline: auto;
    outline-offset: var(--space-1);
  }

  .social svg {
    width: var(--space-6);
    height: var(--space-6);
    fill: currentColor;
  }
</style>
