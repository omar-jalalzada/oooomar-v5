---
import Base from '../layouts/Base.astro';
import { getVisible } from '../lib/content';
import { SOFT_PRESENCE } from '../lib/soft-presence';

if (SOFT_PRESENCE) return Astro.redirect('/');

const work = (await getVisible('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="About | Omar Jalalzada"
  description="Design leader and maker. Head of Design at Sublime Security."
>
  <article class="prose">
    <h1>About</h1>

    <p>
      I'm Omar, a design leader and maker. I lead design at
      <a href="https://sublime.security">Sublime Security</a>, where I've helped take the company
      from 0 to Series D.
    </p>
    <p class="social">
      <a href="https://www.linkedin.com/in/omarjalalzada/" rel="me" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V9h3.56v11.45Z" />
        </svg>
        <span class="sr-only">LinkedIn</span>
      </a>
      <a href="https://x.com/OmarJalalzada" rel="me" aria-label="X">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18.24 2.25h3.31l-7.23 8.26 8.51 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64Z" />
        </svg>
        <span class="sr-only">X</span>
      </a>
    </p>

    <h2>Work</h2>
    <ul class="cv">
      {
        work.map((entry) => (
          <li>
            <div class="line">
              <span class="company">{entry.data.company}</span>
              {entry.data.period && <span class="period">{entry.data.period}</span>}
            </div>
            <p class="role">{entry.data.role}</p>
          </li>
        ))
      }
    </ul>
  </article>
</Base>

<style>
  h1 {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }

  .cv {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  .cv li {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .cv li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .company {
    font-weight: 600;
  }

  .period {
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    white-space: nowrap;
  }

  .role {
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
  }

  .social {
    display: flex;
    gap: var(--space-2);
  }

  .social a {
    display: grid;
    width: var(--space-12);
    height: var(--space-12);
    place-items: center;
    color: var(--color-ink-secondary);
    background: var(--color-surface);
    border: thin solid var(--color-border);
    border-radius: 50%;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .social a:hover {
    color: var(--color-accent);
    background: var(--color-bg);
    border-color: var(--color-accent);
  }

  .social a:active {
    transform: scale(0.96);
  }

  .social a:focus-visible {
    outline: auto;
    outline-offset: var(--space-1);
  }

  .social svg {
    width: var(--space-6);
    height: var(--space-6);
    fill: currentColor;
  }
</style>
