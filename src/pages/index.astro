---
/*
  A holding page. The bar field that used to live here is now a lab —
  `public/prototypes/bar-field/`, listed in Experiments.
*/
import Base from '../layouts/Base.astro';
---

<Base
  title="Omar Jalalzada"
  description="Omar Jalalzada — Head of Design at Sublime Security. work in progress."
>
  {/* The visible line is the whole page, and it isn't the site's heading — the name is,
      so that stays as the one real heading for crawlers and screen readers. */}
  <h1 class="sr-only">Omar Jalalzada</h1>
  <p class="wip">work in progress</p>
</Base>

<style>
  /* Fixed to the viewport rather than laid out inside `main`, whose padding would pull it
     off centre. The nav floats above it, so it stays clickable. */
  .wip {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
  }
</style>
