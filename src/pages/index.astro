---
import Base from '../layouts/Base.astro';
import Constellation from '../components/constellation/Constellation.astro';
import { getVisible, byDateDesc } from '../lib/content';
import { formatDate, topicLabels } from '../lib/format';

const writing = (await getVisible('writing')).sort(byDateDesc);
const experiments = (await getVisible('experiments')).sort(byDateDesc);
const aboutEntries = (await getVisible('about')).sort(byDateDesc);

const writingCards = writing.map((p) => ({
  href: `/writing/${p.id}/`,
  cat: 'writing' as const,
  slug: p.id,
  title: p.data.title,
  desc: p.data.description,
  meta: `${topicLabels[p.data.topic]} · ${formatDate(p.data.date)}`,
}));

const experimentCards = experiments.map((l) => ({
  href: `/experiments/${l.id}/`,
  cat: 'experiment' as const,
  slug: l.id,
  title: l.data.title,
  desc: l.data.description,
  meta: `Prototype · ${formatDate(l.data.date)}`,
}));

const aboutCards = aboutEntries.map((a) => ({
  href: a.data.href ?? `/about/${a.id}/`,
  cat: 'about' as const,
  slug: a.id,
  title: a.data.title,
  desc: a.data.description,
  meta: a.data.meta ?? '',
}));

const cards = [...writingCards, ...experimentCards, ...aboutCards];
---

<Base
  title="Omar Jalalzada — Design leadership in cybersecurity"
  description="Design leader at Sublime Security. Writing on design leadership, interactive experiments, and case studies from cybersecurity, healthcare, and finance."
  immersive
>
  <!-- Legible to search engines & screen readers; the visual identity is the canvas below. -->
  <header class="sr-only">
    <h1>Omar Jalalzada — Head of Design at Sublime Security</h1>
    <p>
      A design lead in love with designing — a craftsman first. Writing on design leadership and
      reflections, interactive experiments, and how to get in touch.
    </p>
  </header>

  <Constellation cards={cards} />
</Base>
