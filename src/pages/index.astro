---
import Base from '../layouts/Base.astro';
import BarField from '../components/barfield/BarField.astro';
---

<Base
  title="Omar Jalalzada"
  description="Omar Jalalzada — Head of Design at Sublime Security. work in progress."
  immersive
>
  <!-- Legible to search engines & screen readers; the visual identity is the field below,
       which is a canvas and says nothing on its own. The tagline inside it is aria-hidden
       so this is the single copy of both. -->
  <header class="sr-only">
    <h1>Omar Jalalzada</h1>
    <p>work in progress.</p>
  </header>

  <BarField />
</Base>
