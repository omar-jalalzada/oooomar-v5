---
import Base from '../../layouts/Base.astro';
import { CardGrid } from '../../components/ui/ExperimentsGrid';
import { getVisible, byDateDesc } from '../../lib/content';
import { formatDate } from '../../lib/format';
import { SOFT_PRESENCE } from '../../lib/soft-presence';

if (SOFT_PRESENCE) return Astro.redirect('/');

const posts = (await getVisible('writing')).sort(byDateDesc);

const cards = posts.map((post) => ({
  href: `/writing/${post.id}/`,
  title: post.data.title,
  description: post.data.description,
  meta: formatDate(post.data.date),
  draft: post.data.status === 'draft',
}));
---

<Base
  title="Writing — Omar Jalalzada"
  description="Writing on design leadership, cybersecurity, and systems for a calm life."
>
  <h1>Writing</h1>
  <CardGrid client:visible {cards} />
</Base>

<style>
  h1 {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }
</style>
