---
import Base from '../../layouts/Base.astro';
import { FilterBar } from '../../components/ui/FilterBar';
import { getVisible, byDateDesc } from '../../lib/content';
import { formatDate, topicLabels } from '../../lib/format';

const posts = (await getVisible('writing')).sort(byDateDesc);

const topics = [
  { value: 'all', label: 'All' },
  { value: 'design-leadership', label: 'Design Leadership' },
  { value: 'reflections', label: 'Reflections' },
];

const cards = posts.map((post) => ({
  href: `/writing/${post.id}/`,
  title: post.data.title,
  description: post.data.description,
  meta: `${topicLabels[post.data.topic]} · ${formatDate(post.data.date)}`,
  draft: post.data.status === 'draft',
  topic: post.data.topic,
}));

const initialTopic = Astro.url.searchParams.get('topic') ?? 'all';
---

<Base
  title="Writing — Omar Jalalzada"
  description="Writing on design leadership, cybersecurity, and systems for a calm life."
>
  <h1>Writing</h1>
  <FilterBar client:load {topics} {cards} {initialTopic} />
</Base>

<style>
  h1 {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }
</style>
