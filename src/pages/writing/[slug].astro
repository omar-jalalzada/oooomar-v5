---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getVisible } from '../../lib/content';
import { formatDate, topicLabels } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getVisible('writing');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} — Omar Jalalzada`} description={post.data.description}>
  <article>
    <header>
      <p class="meta">
        <a href={`/writing/?topic=${post.data.topic}`}>{topicLabels[post.data.topic]}</a>
        · <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.status === 'draft' && <span class="draft">Draft</span>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      post.data.tags.length > 0 && (
        <footer>
          <ul class="tags">
            {post.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
</Base>

<style>
  article > header {
    max-width: var(--measure);
    margin-bottom: var(--space-12);
  }

  .meta {
    font-size: var(--text-sm);
    color: var(--color-ink-tertiary);
    margin-bottom: var(--space-3);
  }

  .meta a {
    color: var(--color-ink-secondary);
    text-decoration: none;
  }

  .meta a:hover {
    text-decoration: underline;
  }

  .draft {
    margin-left: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  h1 {
    font-size: var(--text-2xl);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .description {
    font-size: var(--text-lg);
    line-height: 1.4;
    color: var(--color-ink-secondary);
  }

  article > footer {
    max-width: var(--measure);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags li {
    font-size: var(--text-xs);
    color: var(--color-ink-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-1) var(--space-3);
  }
</style>
