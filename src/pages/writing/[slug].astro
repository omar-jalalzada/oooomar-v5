---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getVisible } from '../../lib/content';
import { formatDate, topicLabels } from '../../lib/format';
import { SOFT_PRESENCE } from '../../lib/soft-presence';

export async function getStaticPaths() {
  if (SOFT_PRESENCE) return [];
  const posts = await getVisible('writing');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} — Omar Jalalzada`} description={post.data.description}>
  <article class="detail">
    <header>
      <p class="meta">
        <a href={`/writing/?topic=${post.data.topic}`}>{topicLabels[post.data.topic]}</a>
        · <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.status === 'draft' && <span class="draft">Draft</span>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      post.data.tags.length > 0 && (
        <footer>
          <ul class="tags">
            {post.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
</Base>
