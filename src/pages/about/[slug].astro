---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getVisible } from '../../lib/content';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const entries = await getVisible('about');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — Omar Jalalzada`} description={entry.data.description}>
  <article class="detail">
    <header>
      <p class="meta">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
        {entry.data.status === 'draft' && <span class="draft">Draft</span>}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="description">{entry.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
