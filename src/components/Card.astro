---
interface Props {
  href: string;
  title: string;
  description: string;
  meta?: string;
  tags?: string[];
  draft?: boolean;
}

const { href, title, description, meta, tags = [], draft = false } = Astro.props;
---

<article class="card" data-tags={tags.join(',')}>
  <h3>
    <a href={href}>{title}</a>
    {draft && <span class="draft">Draft</span>}
  </h3>
  <p class="description">{description}</p>
  {meta && <p class="meta">{meta}</p>}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 0.5px solid var(--color-hairline);
    border-radius: var(--radius-card);
    box-shadow: 0 2px 6px rgba(40, 40, 90, 0.05), 0 28px 64px -44px rgba(60, 70, 180, 0.2);
    transition: transform 0.4s cubic-bezier(0.2, 0.75, 0.2, 1),
      box-shadow 0.4s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  h3 {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.35;
  }

  h3 a {
    text-decoration: none;
  }

  /* make the whole card the click target */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 2px 6px rgba(40, 40, 90, 0.12), 0 44px 84px -36px rgba(60, 70, 180, 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    .card:hover {
      transform: none;
    }
  }

  .draft {
    margin-left: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .description {
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
  }

  .meta {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
  }
</style>
